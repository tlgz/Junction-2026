# Server configuration
PORT=3000

# Hostinger AI Router (or any OpenAI-compatible provider for local dev)
HOSTINGER_AI_KEY=your_hostinger_ai_router_key
HOSTINGER_AI_ROUTER_URL=https://router.hostinger.com/v1
MODEL=gpt-4.1-mini

# Oxylabs AI Studio (AI-Scraper) key: scrapes linked pages for extra context. Optional.
OXYLABS_API_KEY=your_oxylabs_ai_studio_key
SCRAPE_BUDGET_MS=4000
