# Server configuration
PORT=3000

# Detector: Dnoise propaganda classifier on Verda (see inference/README.md). Required.
# URL = the deployment's Containers API URL + /api/classify; key = Verda inference API key,
# used for the detector AND the explainer.
VERDA_URL=https://containers.datacrunch.io/dnoise/api/classify
VERDA_API_KEY=your_verda_inference_api_key
# Score at which a post is flagged and explained (keep in sync with the extension's verdict.ts)
PROPAGANDA_THRESHOLD=0.40

# Explainer: LLM on Verda's inference API explains WHY a flagged post is propaganda.
# Uses VERDA_API_KEY unless EXPLAINER_API_KEY is set. Other model: deepseek-4-1-flash-1017
EXPLAINER_MODEL=kimi-k3-1-pro
# EXPLAINER_URL=https://inference.verda.com/v1
# EXPLAINER_API_KEY=

# Oxylabs AI Studio (AI-Scraper) key: scrapes linked pages for extra context. Optional.
OXYLABS_API_KEY=your_oxylabs_ai_studio_key
SCRAPE_BUDGET_MS=4000
